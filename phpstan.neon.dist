parameters:
    level: 10
    paths:
        - .
    excludePaths:
        - vendor (?)
        - Test/Js/node_modules (?)
    bootstrapFiles:
        - ../../../../vendor/autoload.php
        - ../../../../dev/tests/integration/framework/autoload.php
    scanFiles:
        - Test/phpstan/generated/SortFieldInterfaceFactory.php
    scanDirectories:
        - ../../../../generated/code
        - ../../../../dev/tests/integration/framework
