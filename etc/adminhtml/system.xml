<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="catalog_sorting">
            <group id="price" translate="label" type="text" sortOrder="170"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Price Directions</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <comment>Offers "Price: Low to High" and "Price: High to Low" in Sort By, each ordering in its own direction. To show only these two, hide Price in Sort Options.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
